NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/app_db
JWT_SECRET=your-secret-key-change-this-to-a-long-random-string

# Test Database Configuration
# REQUIRED for running Vitest integration tests. Must point to a separate database containing 'test' in its name.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/app_test_db

# CORS Configuration
# Set to 'false' to disable CORS completely (useful for native mobile-only projects such as Expo Android/iOS)
CORS_ENABLED=true
# Comma-separated list of allowed origins (e.g. React web, Expo web, production web domains)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006
CORS_CREDENTIALS=true
